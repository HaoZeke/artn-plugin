SystemName		siO.lua
SystemLabel		lua_siO_strand

%block SCF.Mixers
  Pulay
  Linear
  Broyden
%endblock SCF.Mixers

%block SCF.Mixer.Pulay
  # Mixing method
  method pulay
  variant stable

  # Mixing options
  weight 0.0500
  weight.linear 0.0500
  history 3
%endblock

%block SCF.Mixer.Broyden
  # Mixing method
  method broyden

  # Mixing options
  weight 0.0500
  weight.linear 0.0500
  history 5
%endblock

%block SCF.Mixer.Linear
  # Mixing method
  method linear

  # Mixing options
  weight 0.1
%endblock


