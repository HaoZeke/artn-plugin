# ---------- Initialize Simulation --------------------- 
clear 
units       metal 
dimension   3 
boundary    p p p 
atom_style  atomic 
# atom_modify map array

atom_modify sort 0 1

# ---------- Create Atoms --------------------- 
read_data   conf.sw

# ---------- Define Interatomic Potential --------------------- 
pair_style   sw 
pair_coeff   * * Si.sw Si

mass        1  29.0

neighbor     2.0 bin 
neigh_modify delay 10 check yes 

 
# ---------- Define Settings --------------------- 
compute eng all pe/atom 
compute eatoms all reduce sum c_eng 


# ----------- OUTPUT
#dump 10  all custom 1 config.dmp id type x y z fx fy fz

#thermo 10 
#thermo_style custom step pe fnorm lx ly lz press pxx pyy pzz c_eatoms 


# ----------- ARTn
#displace_atoms	all random 0.05 0.05 0.05 1258475
plugin   load   ../../libartn.so
plugin   list

fix             10 all artn alpha0 0.2 dmax 0.5
#fix             10 all artn alpha0 0.1 alphashrink 0.99 dtshrink 0.5 dmax 0.5 tmax 20 tmin 0.02


# ---------- Run Minimization --------------------- 
#fix 1 all box/relax iso 0.0 vmax 0.001

timestep 0.002
min_style fire 

#min_modify: dmax or delaystep or dtgrow or dtshrink or alpha0 or alphahrink or...
#            tmax or tmin or halfstepback or initialdelay or vdfmax or line or...
#            norm or discrete_factor or integrator or tmax  
#            alpha_damp: does not work anymore

variable iter loop 1 2    # here you define the number of searches you want 
label boucle

minimize 0.0  1e-8 10000 10000 

next iter
jump SELF boucle


#variable natoms equal "count(all)" 
#variable teng equal "c_eatoms"
#variable length equal "lx"
#variable ecoh equal "v_teng/v_natoms"
#
#print "Total energy (eV) = ${teng};"
#print "Number of atoms = ${natoms};"
#print "Lattice constant (Angstoms) = ${length};"
#print "Cohesive energy (eV) = ${ecoh};"

print "All done!" 
#undump 10
