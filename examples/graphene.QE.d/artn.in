&ARTN_PARAMETERS
! Control  
  engine_units = 'QE'
  verbose = 3 
  lpush_final = .true. 
  ninit = 2 
  forc_thr = 0.01 
  push_step_size = 0.3
  ! parameters for the push
  push_mode = 'list'
  ! define which atoms are to be pushed and the constraints ...
  push_ids = 1  
  push_add_const(:,1) = 0.0, 1.0, 0.0
  ! lanczos parameters
  lanczos_disp = 0.1D-1 
  lanczos_max_size = 16
  ! eigenpush parms
  eigen_step_size = 0.3
/
