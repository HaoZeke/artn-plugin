&ARTN_PARAMETERS
  !! Units definition::(eV,Ang,ps)  
  engine_units='lammps/metal'
  verbose = 1
  !lrestart = .true.

  zseed =     27135724
  !zseed = 17588998

  !! ARTn mode
  !lrestart = .true.
  ninit = 0 
  lpush_final = .true. 
  nsmooth = 3 
  nnewchance= 30
  forc_thr = 0.05
  nperp_limitation = 4, 10, 15, 20, 25, 30, 35, -1 
  restart_freq=0

  !! parameters for the push
  push_step_size = 0.40
  push_mode = 'rad'
  push_dist_thr=3.5
  push_ids= 955 
  !push_step_size_per_atom = 0.2
  !push_step_size = 0.2
  !push_mode = 'list'
  !push_ids = 17

  !! lanczos parameters
  lanczos_disp = 1.0D-2
  lanczos_min_size = 3
  lanczos_max_size = 50 
  
  !! eigenpush parms
  eigen_step_size = 0.1
  frelax_ene_thr = 0.01
  push_over=6.0
  !eigen_step_size = 0.15
  !frelax_ene_thr = -0.005
  !nnewchance = 2
/
