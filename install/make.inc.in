##
##
## @configure_input@
##
## For more details see 'install/config.log' file
##
artn_configured="yes"

include @topdir@/install/func4makefile

TOPDIR=@topdir@

F90=@f90@
MPIF90=@mpif90@
##
## fortran compiler version:
## @f90_version@
##

FCFLAGS=@FCFLAGS@


INTEL=@INTEL@

FC_MODINC=@FC_MODINC@
FC_MODOUT=@FC_MODOUT@

BLAS_LIB=@BLAS_LIB@

## ============
## definitions for QE
## QE version: @QE_VERSION@
##
with_qe="@with_qe@"

QE_PATH=@QE_PATH@


## ============
## definitions for the LAMMPS plugin
## LAMMPS version: @LMP_VERSION@
## LAMMPS was built with: <machine> = @LMP_MACHINE@
##
with_lammps="@with_lammps@"

CXX=@CXX@
CC=@CC@

LAMMPS_PATH=@LAMMPS_PATH@
LIBLAMMPS=@LIBLAMMPS@

FORT_LIB=@FORT_LIB@

MPIFORT_LIB=@MPIFORT_LIB@

## ============
## definitions for Siesta
##
with_siesta="@with_siesta@

LUALIB=@lualib@

