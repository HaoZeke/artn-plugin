##
## export some values so this file can be directly included by other projects
##
## NOTE: these are only correct if pARTn was compiled in the default way.
##

## path to generated libraries (symlinks)
LIBARTN_PATH=@topdir@/lib

## the static library
LIBARTN_STATIC=@topdir@/lib/libartn.a

## 'soname' for using as: -L$(LIBARTN_PATH) -l$(LIBARTN_SONAME)
LIBARTN_SONAME=artn

## include path for fortran modules: -I$(LIBARTN_FINCLUDE)
LIBARTN_FINCLUDE=@topdir@/src/Obj

## file containing C headers
LIBARTN_CHEADER=artn.h

## include path for C headers: -I$(LIBARTN_CINCLUDE)
LIBARTN_CINCLUDE=@topdir@/Files_LAMMPS